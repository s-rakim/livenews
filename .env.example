# Copy to .env and fill in. .env is gitignored, never commit real keys.
# With no Alpaca keys the terminal runs on simulated data.

# Alpaca (free account at alpaca.markets, use the PAPER keys from the paper dashboard)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex = free plan. sip = paid consolidated feed.
ALPACA_FEED=iex

# Second news wire, analyst ratings, EPS surprises, insider trades,
# earnings calendar, streaming FX and metals (free key at finnhub.io).
# Price targets need a paid Finnhub plan or the FMP key below.
FINNHUB_API_KEY=
# LIVENEWS_FX_STREAM=off   to skip the FX WebSocket

# Rates, oil, gas and the economic calendar (free key at fred.stlouisfed.org)
FRED_API_KEY=

# Company financials, filings and 13F institutional holders from SEC EDGAR.
# No key, but the SEC requires a User-Agent with your name and email.
# It's only sent to sec.gov.
LIVENEWS_SEC_USER_AGENT=

# Delayed indices, futures, yields and FX come from Yahoo's chart data (no key).
# LIVENEWS_DELAYED=off   to turn that off and use FRED/ECB/ETF proxies only

# Where watchlists and alerts are saved (default ~/.livenews)
# LIVENEWS_HOME=

# House trades are read from the House Clerk's filings, no key needed.
# LIVENEWS_HOUSE=off   to skip that
# Senate trades and a price target fallback (financialmodelingprep.com)
FMP_API_KEY=
# Names to watch in disclosures and in the news wire
LIVENEWS_PEOPLE=Pelosi,Cramer,Tuberville,Crenshaw,Khanna,McCaul,Greene,Gottheimer,Mullin

# Tickers that always stream (free plan streams up to 30)
LIVENEWS_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD

# Poll intervals in seconds
LIVENEWS_NEWS_INTERVAL=1
LIVENEWS_QUOTES_INTERVAL=2
LIVENEWS_MOVERS_INTERVAL=5

# Chat between livenews terminals. With nothing set, the first terminal on this
# machine hosts a relay on 127.0.0.1:8765 and the rest join it.
# LIVENEWS_CHAT_NAME=yourname
# LIVENEWS_CHAT_URL=ws://some-host:8765      join a relay somewhere else
# LIVENEWS_CHAT_SERVE=0.0.0.0:8765           host one for other machines (needs the token)
# LIVENEWS_CHAT_TOKEN=a-long-shared-secret
# LIVENEWS_CHAT=off

# Safety. Orders above this dollar value are refused before they leave your machine.
# Options count 100 shares per contract.
LIVENEWS_MAX_ORDER_VALUE=5000

# Paper is the default. Live trading needs BOTH of these, plus your live keys:
# LIVENEWS_TRADING_MODE=live
# LIVENEWS_ALLOW_LIVE=yes-i-understand
LIVENEWS_TRADING_MODE=paper
