# Copy to .env and fill in. .env is gitignored, never commit real keys.
# With no Alpaca keys the terminal runs on simulated data.

# Alpaca (free account at alpaca.markets, use the PAPER keys from the paper dashboard)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex = free plan. sip = paid consolidated feed.
ALPACA_FEED=iex

# Second news wire, analyst ratings, EPS surprises, insider trades,
# earnings calendar, company profile (free key at finnhub.io)
FINNHUB_API_KEY=

# Rates, oil, gas and the economic calendar (free key at fred.stlouisfed.org)
FRED_API_KEY=

# Company financials and filings from SEC EDGAR. No key, but the SEC requires
# a User-Agent with your name and email. It's only sent to sec.gov.
LIVENEWS_SEC_USER_AGENT=

# Where watchlists and alerts are saved (default ~/.livenews)
# LIVENEWS_HOME=

# Optional congressional trade disclosures (financialmodelingprep.com)
FMP_API_KEY=
# Names to watch in disclosures and in the news wire
LIVENEWS_PEOPLE=Pelosi,Cramer,Tuberville,Crenshaw,Khanna,McCaul,Greene,Gottheimer,Mullin

# Tickers that always stream (free plan streams up to 30)
LIVENEWS_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD

# Poll intervals in seconds
LIVENEWS_NEWS_INTERVAL=1
LIVENEWS_QUOTES_INTERVAL=2
LIVENEWS_MOVERS_INTERVAL=5

# Safety. Orders above this dollar value are refused before they leave your machine.
LIVENEWS_MAX_ORDER_VALUE=5000

# Paper is the default. Live trading needs BOTH of these, plus your live keys:
# LIVENEWS_TRADING_MODE=live
# LIVENEWS_ALLOW_LIVE=yes-i-understand
LIVENEWS_TRADING_MODE=paper
